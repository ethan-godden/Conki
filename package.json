{
  "name": "conki",
  "version": "1.0.0",
  "private": true,
  "description": "Anki note type for code cards: Markdown fields, read-only code blocks, and a typed answer that is diffed against the expected code.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "clean": "sh scripts/clean.sh",
    "deploy": "sh scripts/deploy.sh",
    "pretest": "tsc && npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "markdown-it": "^15.0.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2"
  }
}
